# Copia este archivo como .env y completa los valores.

# --- Local ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña
DB_DATABASE=bdveterinariasonrisas
DB_SCHEMA=veterinariasonrisas
DB_SSL=false

# --- Supabase (Session pooler) ---
# DB_HOST=aws-X-REGION.pooler.supabase.com   (cópialo del botón Connect)
# DB_PORT=5432
# DB_USER=postgres.REFERENCIA_DEL_PROYECTO
# DB_PASSWORD=contraseña_de_la_base
# DB_DATABASE=postgres
# DB_SCHEMA=veterinariasonrisas
# DB_SSL=true

# --- Inicio de sesión (JWT) ---
# Genera un secreto largo y aleatorio, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=8h
